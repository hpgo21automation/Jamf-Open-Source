<plist version="1"><dict><key>PayloadUUID</key><string>8b298229-087e-4409-8b88-da6bc9b33938</string><key>PayloadType</key><string>Configuration</string><key>PayloadOrganization</key><string>Example</string><key>PayloadIdentifier</key><string>8b298229-087e-4409-8b88-da6bc9b33938</string><key>PayloadDisplayName</key><string>PPPC - Logi Options+ Accessibility</string><key>PayloadDescription</key><string>Grants Logi Options+ (main app and the cp-dev-mgr agent) the Accessibility permission needed to control pointer devices, so users are not prompted after install.</string><key>PayloadVersion</key><integer>1</integer><key>PayloadEnabled</key><true/><key>PayloadRemovalDisallowed</key><false/><key>PayloadScope</key><string>System</string><key>PayloadContent</key><array><dict><key>PayloadUUID</key><string>B3EDA768-9C08-49F3-846C-32CDE0AD7F8A</string><key>PayloadType</key><string>com.apple.TCC.configuration-profile-policy</string><key>PayloadOrganization</key><string>Example</string><key>PayloadIdentifier</key><string>com.apple.TCC.configuration-profile-policy.B3EDA768-9C08-49F3-846C-32CDE0AD7F8A</string><key>PayloadDisplayName</key><string>Privacy Preferences Policy Control</string><key>PayloadDescription</key><string>Grants Logi Options+ Accessibility permission.</string><key>PayloadVersion</key><integer>1</integer><key>PayloadEnabled</key><true/><key>Services</key><dict><key>Accessibility</key><array><dict><key>Identifier</key><string>com.logi.optionsplus</string><key>CodeRequirement</key><string>identifier "com.logi.optionsplus" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = "QED4VVPZWA"</string><key>IdentifierType</key><string>bundleID</string><key>Allowed</key><true/></dict><dict><key>Identifier</key><string>com.logi.cp-dev-mgr</string><key>CodeRequirement</key><string>identifier "com.logi.cp-dev-mgr" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = "QED4VVPZWA"</string><key>IdentifierType</key><string>bundleID</string><key>Allowed</key><true/></dict></array></dict></dict></array></dict></plist>
