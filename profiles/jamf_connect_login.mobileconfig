<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>PayloadContent</key>
		<array>
			<dict>
				<key>AllowNetworkSelection</key>
				<true/>
				<key>BackgroundImage</key>
				<string>/usr/local/jamfconnect/background.jpg</string>
				<key>ChangePasswordURL</key>
				<string>https://example.okta.com/enduser/settings</string>
				<key>CreateJamfConnectPassword</key>
				<true/>
				<key>CreateNewUserHide</key>
				<true/>
				<key>DenyLocal</key>
				<true/>
				<key>DenyLocalExcluded</key>
				<array>
					<string>srv_support</string>
					<string>srv_mac</string>
				</array>
				<key>EnableFDE</key>
				<false/>
				<key>LocalFallback</key>
				<true/>
				<key>LoginLogo</key>
				<string>/usr/local/jamfconnect/logo.png</string>
				<key>LoginWindowMessage</key>
				<string>Login with your Okta username/password</string>
				<key>Migrate</key>
				<true/>
				<key>MigrateUsersHide</key>
				<array>
					<string>srv_support</string>
					<string>srv_mac</string>
				</array>
				<key>OIDCClientID</key>
				<string>REDACTED</string>
				<key>OIDCProvider</key>
				<string>OktaIdentityEngine</string>
				<key>OIDCRedirectURI</key>
				<string>https://127.0.0.1/jamfconnect</string>
				<key>OIDCTenant</key>
				<string>example.okta.com</string>
				<key>PayloadDisplayName</key>
				<string>Jamf Connect Login</string>
				<key>PayloadIdentifier</key>
				<string>com.example.jamfconnect.login.settings</string>
				<key>PayloadType</key>
				<string>com.jamf.connect.login</string>
				<key>PayloadUUID</key>
				<string>7A1B2C3D-4E5F-6789-ABCD-EF0123456789</string>
				<key>PayloadVersion</key>
				<integer>1</integer>
			</dict>
		</array>
		<key>PayloadDescription</key>
		<string/>
		<key>PayloadDisplayName</key>
		<string>Jamf Connect - Login</string>
		<key>PayloadEnabled</key>
		<true/>
		<key>PayloadIdentifier</key>
		<string>cc494c1b-5bdc-4631-8a8d-7f3550a9b81c</string>
		<key>PayloadOrganization</key>
		<string>Example</string>
		<key>PayloadRemovalDisallowed</key>
		<true/>
		<key>PayloadScope</key>
		<string>System</string>
		<key>PayloadType</key>
		<string>Configuration</string>
		<key>PayloadUUID</key>
		<string>cc494c1b-5bdc-4631-8a8d-7f3550a9b81c</string>
		<key>PayloadVersion</key>
		<integer>1</integer>
	</dict>
</plist>